# Django Settings
DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/plataforma_estetica

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tienda Nube - app de partners (solo emite cupones de descuento)
# Obtener de: panel de partners -> la app -> Claves de Acceso
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# Twilio (for WhatsApp notifications)
# Obtener de: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de WhatsApp Business aprobado (sin el prefijo "whatsapp:")
TWILIO_WHATSAPP_NUMBER=+5491112345678
# URL pública de tu servidor para recibir status callbacks
# Ejemplo: https://tu-app.onrender.com o https://api.tu-dominio.com
TWILIO_WEBHOOK_BASE_URL=https://tu-dominio.com

# AWS S3 - archivos públicos (foto de producto, logo del centro)
# Sin AWS_STORAGE_BUCKET_NAME el storage público cae al disco local (dev).
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=sa-east-1
# Dominio de CloudFront; vacío hasta que exista la distribución
AWS_S3_CUSTOM_DOMAIN=

# Cloudinary (alternative to S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
