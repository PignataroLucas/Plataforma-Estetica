# Django
DEBUG=False
SECRET_KEY=change-me-generate-a-50-char-random-string
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1

# Database (Railway Postgres auto-injects DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (optional; Railway Redis plugin auto-injects REDIS_URL)
REDIS_URL=redis://localhost:6379/0

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.up.railway.app

# HTTPS redirect (set False if Railway healthchecks fail)
SECURE_SSL_REDIRECT=True

# Gunicorn tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# AWS S3 - archivos públicos (foto de producto, logo del centro)
# Sin AWS_STORAGE_BUCKET_NAME el storage público cae al disco local, que sirve
# para desarrollo pero NO para producción: Railway borra el disco en cada deploy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1
AWS_S3_CUSTOM_DOMAIN=

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
